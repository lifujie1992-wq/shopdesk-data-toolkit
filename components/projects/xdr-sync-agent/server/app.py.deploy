]
# Both doudian and doudian_client share the same column set.
DOUDIAN_CLIENT_DAILY_COLUMNS = [*DOUDIAN_DAILY_COLUMNS]


def _doudian_columns(dataset: str) -> list[str]:
    """Columns actually present in the published table.

    Lets a schema update ship before the next sync without breaking reads:
    columns not yet uploaded are omitted until they arrive with the next sync.
    """
    try:
        with closing(connect(dataset)) as connection:
            cursor = connection.execute("SELECT * FROM shop_metrics_daily LIMIT 0")
            present = {item[0] for item in cursor.description}
    except Exception:
        return []
    return [column for column in DOUDIAN_DAILY_COLUMNS if column in present]


def doudian_snapshot(dataset: str = "doudian") -> dict[str, Any]:
    if not doudian_available(dataset):
        raise HTTPException(status_code=404, detail=f"{dataset} dataset is not published")
    snapshot = one(
        dataset,
        "SELECT max(stat_date) AS stat_date, max(captured_at) AS captured_at,"
        "count(DISTINCT shop_id) AS shop_count,"
        "count(*) AS row_count FROM shop_metrics_daily",
        [],
    )
    return {**snapshot, "data_version": snapshot["captured_at"]}


