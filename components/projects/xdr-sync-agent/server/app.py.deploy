    values.extend((limit, offset))
    result = rows(
        "inventory",
        f"SELECT {','.join(SHOP_PRODUCT_SALES_COLUMNS)} "
        f"FROM shop_product_sales_analysis WHERE {' AND '.join(filters)} "
        "ORDER BY sales_qty DESC, spu_id, shop_id LIMIT ? OFFSET ?",
