        raise HTTPException(status_code=404, detail="Profit-analysis dataset is not published")
    run = one(
        "profit_analysis",
        "SELECT * FROM profit_analysis_runs WHERE complete=1 "
        "ORDER BY end_date DESC,captured_at DESC LIMIT 1",
        [],
    )
    return {**run, "rate_unit": "decimal_ratio"}


@app.get("/v1/bi/sku-profit-analysis", tags=["bi"])
def sku_profit_analysis(
    _: Auth,
    limit: PageLimit = 100,
    offset: PageOffset = 0,
    start_date: date | None = None,
    end_date: date | None = None,
    sku_id: str | None = None,
    spu_id: str | None = None,
    min_profit_rate: float | None = None,
    max_profit_rate: float | None = None,
    loss_only: bool = False,
    sort_by: str = "profit",
    descending: bool = True,
) -> dict[str, Any]:
    """Query one SKU-profit window; all percentage fields are decimal ratios."""
    if not profit_analysis_available():
        raise HTTPException(status_code=404, detail="Profit-analysis dataset is not published")
    if start_date and not end_date:
        raise HTTPException(status_code=422, detail="start_date requires end_date")
    sort_columns = {
        "profit": "profit", "profit_rate": "profit_rate", "gross_profit": "gross_profit",
        "gross_profit_rate": "gross_profit_rate", "sales_amount": "sales_amount",
        "net_sales_amount": "net_sales_amount", "net_sales_qty": "net_sales_qty",
    }
    if sort_by not in sort_columns:
        raise HTTPException(status_code=422, detail="Invalid sort_by")
    run_filters = ["complete=1"]
    run_values: list[Any] = []
    if end_date:
        run_filters.append("end_date=?")
        run_values.append(end_date.isoformat())
    if start_date:
        run_filters.append("start_date=?")
        run_values.append(start_date.isoformat())
    run = one(
        "profit_analysis",
        f"SELECT * FROM profit_analysis_runs WHERE {' AND '.join(run_filters)} "
        "ORDER BY end_date DESC,captured_at DESC LIMIT 1",
        run_values,
    )
    filters = ["start_date=?", "end_date=?"]
    values: list[Any] = [run["start_date"], run["end_date"]]
    add_filter(filters, values, "sku_id", sku_id)
    add_filter(filters, values, "spu_id", spu_id)
    if min_profit_rate is not None:
        filters.append("profit_rate>=?")
        values.append(min_profit_rate)
    if max_profit_rate is not None:
        filters.append("profit_rate<=?")
        values.append(max_profit_rate)
    if loss_only:
        filters.append("profit<0")
    values.extend((limit, offset))
    items = rows(
        "profit_analysis",
        f"SELECT {','.join(PROFIT_ANALYSIS_COLUMNS)} FROM sku_profit_analysis "
        f"WHERE {' AND '.join(filters)} ORDER BY {sort_columns[sort_by]} "
        f"{'DESC' if descending else 'ASC'},sku_id ASC LIMIT ? OFFSET ?",
        values,
    )
    total = rows(
        "profit_analysis",
        f"SELECT count(*) AS total FROM sku_profit_analysis WHERE {' AND '.join(filters)}",
        values[:-2],
    )[0]["total"]
    return {**page_result(items, limit, offset), "total": total, "run": run,
            "rate_unit": "decimal_ratio"}


def shop_products_snapshot() -> dict[str, Any]:
    if not shop_products_available():
        raise HTTPException(status_code=404, detail="Shop-product dataset is not published")
    return one("shop_products", "SELECT * FROM snapshot_info WHERE id=1 AND complete=1", [])


def cursor_result(items: list[dict[str, Any]], limit: int, snapshot: dict[str, Any]) -> dict[str, Any]:
    next_cursor = items[-1]["cursor"] if len(items) == limit else None
    return {
        "items": items, "limit": limit, "next_cursor": next_cursor,
        "has_more": next_cursor is not None, "snapshot": snapshot,
        "data_version": snapshot["captured_at"],
    }


@app.get("/v1/bi/shop-products/status", tags=["bi"])
def shop_products_status(_: Auth) -> dict[str, Any]:
    return shop_products_snapshot()


@app.get("/v1/bi/shop-product-items", tags=["bi"])
def shop_product_items(
    _: Auth,
    limit: PageLimit = 100,
    after_rowid: int = Query(0, ge=0),
    shop_id: str | None = None,
    platform: str | None = None,
    platform_item_id: str | None = None,
    internal_item_code: str | None = None,
    listed: bool | None = None,
) -> dict[str, Any]:
    snapshot = shop_products_snapshot()
    filters, values = ["rowid>?"], [after_rowid]
    add_filter(filters, values, "shop_id", shop_id)
    add_filter(filters, values, "platform", platform)
    add_filter(filters, values, "platform_item_id", platform_item_id)
    add_filter(filters, values, "internal_item_code", internal_item_code)
    if listed is not None:
        filters.append("is_listed=?")
        values.append(int(listed))
    values.append(limit)
    items = rows(
        "shop_products",
        f"SELECT rowid AS cursor,* FROM shop_product_items WHERE {' AND '.join(filters)} "
        "ORDER BY rowid LIMIT ?", values,
    )
    return cursor_result(items, limit, snapshot)


@app.get("/v1/bi/shop-product-code-summary", tags=["bi"])
def shop_product_code_summary(
    _: Auth,
    product_code: Annotated[
        str, Query(min_length=1, max_length=64, pattern=r"^[0-9]+$")
    ],
) -> dict[str, Any]:
    """Aggregate every raw item code with the same numeric portion."""
    if not product_code.isascii() or not product_code.isdigit():
        raise HTTPException(status_code=422, detail="product_code must contain ASCII digits only")
    snapshot = shop_products_snapshot()
    normalized = (
        "regexp_replace(internal_item_code, '[^0-9]', '', 'g')"
        if DB_PATHS["shop_products"].suffix == ".duckdb"
        else "digits_only(internal_item_code)"
    )
    match = f"{normalized}=?"
    summary = one(
        "shop_products",
        "SELECT count(*) AS link_count,"
        "count(*) FILTER (WHERE is_listed=1) AS listed_link_count,"
        "count(*) FILTER (WHERE is_listed=0) AS unlisted_link_count,"
        "count(*) FILTER (WHERE is_listed IS NULL) AS unknown_status_link_count,"
        "count(DISTINCT shop_id) AS shop_count,"
        "count(DISTINCT CASE WHEN is_listed=1 THEN shop_id END) AS listed_shop_count,"
        "count(DISTINCT CASE WHEN is_listed=0 THEN shop_id END) AS unlisted_shop_count,"
        "count(DISTINCT CASE WHEN is_listed IS NULL THEN shop_id END) AS unknown_status_shop_count "
        f"FROM shop_product_items WHERE {match}",
        [product_code],
    )
    raw_codes = rows(
        "shop_products",
        "SELECT internal_item_code,count(*) AS link_count "
        f"FROM shop_product_items WHERE {match} "
        "GROUP BY internal_item_code ORDER BY link_count DESC,internal_item_code",
        [product_code],
    )
    platforms = rows(
        "shop_products",
        "SELECT platform,count(*) AS link_count,"
        "count(*) FILTER (WHERE is_listed=1) AS listed_link_count,"
        "count(*) FILTER (WHERE is_listed=0) AS unlisted_link_count,"
        "count(*) FILTER (WHERE is_listed IS NULL) AS unknown_status_link_count,"
        "count(DISTINCT shop_id) AS shop_count "
        f"FROM shop_product_items WHERE {match} "
        "GROUP BY platform ORDER BY link_count DESC,platform",
        [product_code],
    )
    return {
        "product_code": product_code,
        "match_rule": "remove_all_non_ascii_digits",
        **summary,
        "matched_raw_codes": raw_codes,
        "platforms": platforms,
        "snapshot": snapshot,
        "data_version": snapshot["captured_at"],
    }


@app.get("/v1/bi/shop-product-skus", tags=["bi"])
def shop_product_skus(
    _: Auth,
    limit: PageLimit = 100,
    after_rowid: int = Query(0, ge=0),
    shop_id: str | None = None,
    platform: str | None = None,
    platform_item_id: str | None = None,
    platform_sku_id: str | None = None,
    sku_id: str | None = None,
    listed: bool | None = None,
) -> dict[str, Any]:
    snapshot = shop_products_snapshot()
    filters, values = ["s.rowid>?"], [after_rowid]
    for column, value in (
        ("i.shop_id", shop_id), ("i.platform", platform),
        ("s.platform_item_id", platform_item_id), ("s.platform_sku_id", platform_sku_id),
        ("s.internal_sku_code", sku_id),
    ):
        if value is not None:
            filters.append(f"{column}=?")
            values.append(value)
    if listed is not None:
        filters.append("s.is_listed=?")
        values.append(int(listed))
    values.append(limit)
    items = rows(
        "shop_products",
        "SELECT s.rowid AS cursor,i.shop_name,i.platform,i.internal_item_code,i.item_name,"
        "i.item_image,i.item_url,s.* FROM shop_product_skus s JOIN shop_product_items i "
        "USING(shop_id,platform_item_id) WHERE " + " AND ".join(filters) +
        " ORDER BY s.rowid LIMIT ?", values,
    )
    return cursor_result(items, limit, snapshot)


@app.get("/v1/bi/shop-product-status-changes", tags=["bi"])
def shop_product_status_changes(
    _: Auth,
    limit: PageLimit = 100,
