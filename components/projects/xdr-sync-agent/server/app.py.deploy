    )
    return {**page_result(result, limit, offset), **_inventory_snapshot_metadata()}


@app.get("/v1/sales/{report_date}/{shop_id}", tags=["sales"])
def get_sale(report_date: date, shop_id: str, _: Auth) -> dict[str, Any]:
    return one(
        "sales",
        f"SELECT {','.join(SALES_COLUMNS)} FROM sales_performance WHERE report_date = ? AND shop_id = ?",
        [report_date.isoformat(), shop_id],
    )


@app.get("/v1/sales", tags=["sales"])
def list_sales(
    _: Auth,
    limit: PageLimit = 100,
    offset: PageOffset = 0,
    report_date: date | None = None,
    date_from: date | None = None,
    date_to: date | None = None,
    shop_id: str | None = None,
    platform: str | None = None,
    owner_name: str | None = None,
) -> dict[str, Any]:
    if report_date and (date_from or date_to):
        raise HTTPException(status_code=422, detail="Use report_date or a date range, not both")
    if date_from and date_to and date_from > date_to:
        raise HTTPException(status_code=422, detail="date_from must not be later than date_to")
    filters: list[str] = []
    values: list[Any] = []
    add_filter(filters, values, "report_date", report_date.isoformat() if report_date else None)
    add_filter(filters, values, "shop_id", shop_id)
    add_filter(filters, values, "platform", platform)
    add_filter(filters, values, "owner_name", owner_name)
    if date_from:
        filters.append("report_date >= ?")
        values.append(date_from.isoformat())
    if date_to:
        filters.append("report_date <= ?")
        values.append(date_to.isoformat())
    where = f" WHERE {' AND '.join(filters)}" if filters else ""
    values.extend((limit, offset))
    result = rows(
        "sales",
        f"SELECT {','.join(SALES_COLUMNS)} FROM sales_performance{where} "
        "ORDER BY report_date DESC, net_sales_income DESC LIMIT ? OFFSET ?",
        values,
    )
    return page_result(result, limit, offset)
