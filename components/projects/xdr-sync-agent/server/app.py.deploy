def connect(database: str) -> Any:
    """Open one configured database in enforced read-only mode."""
    path = DB_PATHS[database]
    if path.suffix == ".duckdb":
        if duckdb is None:
            raise RuntimeError("DuckDB support is not installed")
        return duckdb.connect(str(path), read_only=True)
    uri = f"file:{quote(str(path))}?mode=ro"
    connection = sqlite3.connect(uri, uri=True, timeout=5)
    connection.row_factory = sqlite3.Row
    connection.create_function(
        "digits_only", 1,
        lambda value: "".join(character for character in str(value or "") if character.isascii() and character.isdigit()),
    )
    connection.execute("PRAGMA query_only = ON")
    connection.execute("PRAGMA busy_timeout = 5000")
    return connection


def rows(database: str, sql: str, parameters: list[Any]) -> list[dict[str, Any]]:
    try:
        with closing(connect(database)) as connection:
            cursor = connection.execute(sql, parameters)
            found = cursor.fetchall()
            if DB_PATHS[database].suffix == ".duckdb":
                columns = [item[0] for item in cursor.description]
                return [dict(zip(columns, row)) for row in found]
            return [dict(row) for row in found]
    except Exception as exc:
        if not isinstance(exc, (sqlite3.Error, RuntimeError)) and not (
            duckdb is not None and isinstance(exc, duckdb.Error)
        ):
            raise
        raise HTTPException(status_code=503, detail="Database is temporarily unavailable") from exc


def one(database: str, sql: str, parameters: list[Any]) -> dict[str, Any]:
    result = rows(database, sql, parameters)
    if not result:
        raise HTTPException(status_code=404, detail="Record not found")
    return result[0]


def page_result(items: list[dict[str, Any]], limit: int, offset: int) -> dict[str, Any]:
    return {"items": items, "limit": limit, "offset": offset, "has_more": len(items) == limit}


def add_filter(parts: list[str], values: list[Any], column: str, value: Any) -> None:
    if value is not None:
        parts.append(f'"{column}" = ?')
        values.append(value)


def like_contains(value: str) -> str:
    escaped = value.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
    return f"%{escaped}%"


def require_api_key(x_api_key: Annotated[str | None, Header()] = None) -> None:
    expected = os.getenv("API_KEY", "")
    if not expected or not x_api_key or not hmac.compare_digest(x_api_key, expected):
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid or missing API key",
            headers={"WWW-Authenticate": "ApiKey"},
        )


Auth = Annotated[None, Depends(require_api_key)]
PageLimit = Annotated[int, Query(ge=1, le=500)]
PageOffset = Annotated[int, Query(ge=0, le=1_000_000)]


@asynccontextmanager
async def lifespan(_: FastAPI) -> Iterator[None]:
    if not os.getenv("API_KEY"):
        raise RuntimeError("API_KEY environment variable must be set")
    missing = [str(path) for name, path in DB_PATHS.items()
               if name not in OPTIONAL_DATABASES and not path.is_file()]
    if missing:
        raise RuntimeError(f"Missing database file(s): {', '.join(missing)}")
    yield


app = FastAPI(
    title="JST Read-only API",
    version="1.0.0",
    description="Read-only, API-key protected access to sales, orders, and inventory.",
    lifespan=lifespan,
)


def paid_orders_available() -> bool:
    return DB_PATHS["paid_orders"].is_file()


def profit_analysis_available() -> bool:
    return DB_PATHS["profit_analysis"].is_file()


def shop_products_available() -> bool:
    return DB_PATHS["shop_products"].is_file()


def doudian_available(dataset: str = "doudian") -> bool:
    return DB_PATHS[dataset].is_file()


def warehouse_data_version(run: dict[str, Any] | sqlite3.Row) -> str:
    """A stable batch identity plus its changing Excel capture generation."""
    return f"{run['batch_id']}:{run['captured_at']}"


def spu_live_available() -> bool:
    """Return true only for one complete, coherent live SPU + SKU snapshot."""
    if not DB_PATHS["spu_live"].is_file():
        return False
    try:
        with closing(connect("spu_live")) as connection:
            tables = {row["name"] for row in connection.execute(
                "SELECT name FROM sqlite_master WHERE type='table'"
            )}
            if not {"export_info", "spu_inventory", "sku_inventory"}.issubset(tables):
                return False
            info = connection.execute(
                "SELECT api_total_spu,fetched_spu,fetched_sku "
                "FROM export_info ORDER BY id DESC LIMIT 1"
            ).fetchone()
            if (info is None or info["api_total_spu"] != info["fetched_spu"]
                    or info["fetched_sku"] <= 0):
                return False
            stored_spu = connection.execute("SELECT count(*) FROM spu_inventory").fetchone()[0]
            stored_sku = connection.execute("SELECT count(*) FROM sku_inventory").fetchone()[0]
            return stored_spu == info["fetched_spu"] and stored_sku == info["fetched_sku"]
    except sqlite3.Error:
        return False


def inventory_database() -> str:
    if not spu_live_available():
        return "inventory"
    live_completed_at = _database_snapshot("spu_live").get("completed_at")
    inventory_completed_at = _database_snapshot("inventory").get("completed_at")
    try:
        live_completed = datetime.fromisoformat(str(live_completed_at).replace("Z", "+00:00"))
        inventory_completed = datetime.fromisoformat(
            str(inventory_completed_at).replace("Z", "+00:00"),
        )
    except (TypeError, ValueError):
        return "spu_live" if live_completed_at else "inventory"
    return "inventory" if inventory_completed > live_completed else "spu_live"


def spu_database() -> str:
    """Compatibility name for callers that only need the SPU grain."""
    return inventory_database()


def _database_snapshot(database: str) -> dict[str, Any]:
    """Read optional revision/export metadata without requiring a new schema."""
    if not DB_PATHS[database].is_file():
        return {}
    try:
        with closing(connect(database)) as connection:
            tables = {row["name"] for row in connection.execute(
                "SELECT name FROM sqlite_master WHERE type='table'"
            )}
            result: dict[str, Any] = {}
            if "export_info" in tables:
                found = connection.execute(
                    "SELECT * FROM export_info ORDER BY id DESC LIMIT 1"
                ).fetchone()
                if found is not None:
                    result.update(dict(found))
            if "_xdr_meta" in tables:
                found = connection.execute(
                    "SELECT value FROM _xdr_meta WHERE key='revision'"
                ).fetchone()
                if found is not None:
                    result["revision"] = found["value"]
            return result
    except sqlite3.Error:
        return {}


def _table_completed_at(database: str, table: str) -> str | None:
    if not DB_PATHS[database].is_file():
        return None
    try:
        with closing(connect(database)) as connection:
            exists = connection.execute(
                "SELECT 1 FROM sqlite_master WHERE type='table' AND name=?", [table]
            ).fetchone()
            if not exists:
                return None
            found = connection.execute(
                f'SELECT completed_at FROM "{table}" ORDER BY id DESC LIMIT 1'
            ).fetchone()
            return found["completed_at"] if found is not None else None
    except sqlite3.Error:
        return None


def _table_count(database: str, table: str) -> int | None:
    if not DB_PATHS[database].is_file():
        return None
    try:
        with closing(connect(database)) as connection:
            return int(connection.execute(f'SELECT count(*) FROM "{table}"').fetchone()[0])
    except sqlite3.Error:
        return None


def _inventory_snapshot_metadata(database: str | None = None) -> dict[str, Any]:
    selected = database or inventory_database()
    snapshot = _database_snapshot(selected)
    captured_at = snapshot.get("completed_at")
    snapshot_date = None
    if captured_at:
        try:
            parsed = datetime.fromisoformat(str(captured_at).replace("Z", "+00:00"))
            snapshot_date = parsed.astimezone(timezone(timedelta(hours=8))).date().isoformat()
        except ValueError:
            pass
    return {
        "snapshot_date": snapshot_date,
        "captured_at": captured_at,
        "data_version": snapshot.get("revision") or captured_at,
        "spu_sku_coherent": True,
    }


@app.get("/v1/inventory/status", tags=["inventory"])
def inventory_status(_: Auth) -> dict[str, Any]:
    """Expose source capture times separately from XDR/workbench read times."""
    selected_inventory_database = inventory_database()
    spu = _database_snapshot(selected_inventory_database)
    sku = spu
    spu_revision = spu.get("revision")
    sku_revision = sku.get("revision")
    spu_started = spu.get("started_at")
    spu_completed = spu.get("completed_at")
    sku_started = sku.get("started_at")
    sku_completed = sku.get("completed_at")
    compatibility_started = min(
        (value for value in (spu_started, sku_started) if value), default=None,
    )
    compatibility_completed = min(
        (value for value in (spu_completed, sku_completed) if value), default=None,
    )
    spu_fingerprint = spu_revision or spu_completed or "unknown"
    sku_fingerprint = sku_revision or sku_completed or "unknown"
    return {
        "data_version": f"{spu_fingerprint}:{sku_fingerprint}",
        "spu_revision": spu_revision,
        "sku_revision": sku_revision,
        "spu_source_started_at": spu_started,
        "spu_source_completed_at": spu_completed,
        "sku_source_started_at": sku_started,
        "sku_source_completed_at": sku_completed,
        "shop_shortage_source_completed_at": _table_completed_at(
            "inventory", "shop_shortage_export_info",
        ),
        "source_started_at": compatibility_started,
        "source_completed_at": compatibility_completed,
        "spu_total": int(spu["fetched_spu"]) if spu.get("fetched_spu") is not None
                     else _table_count(selected_inventory_database, "spu_inventory"),
        "sku_total": int(sku["fetched_sku"]) if sku.get("fetched_sku") is not None
                     else _table_count(selected_inventory_database, "sku_inventory"),
        "spu_source": selected_inventory_database,
        "sku_source": selected_inventory_database,
        "spu_sku_coherent": True,
    }


@app.get("/v1/warehouse/status", tags=["warehouse"])
def warehouse_status(_: Auth) -> dict[str, Any]:
    if not paid_orders_available():
        raise HTTPException(status_code=404, detail="Paid-order warehouse is not published")
    result = one("paid_orders", "SELECT * FROM warehouse_runs ORDER BY published_at DESC LIMIT 1", [])
    result["data_version"] = warehouse_data_version(result)
    return result


def _parse_timestamp(value: Any) -> datetime | None:
    """Parse an ISO-8601 timestamp, normalising naive values to UTC."""
    if value is None or value == "":
        return None
    try:
        parsed = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except ValueError:
        return None
    return parsed if parsed.tzinfo else parsed.replace(tzinfo=timezone.utc)


def _latest_timestamp(values: Any) -> str | None:
    """Return the newest ISO-8601 value so mixed offsets still compare correctly."""
    newest: tuple[datetime, str] | None = None
    for value in values:
        parsed = _parse_timestamp(value)
        if parsed is None:
            continue
        if newest is None or parsed > newest[0]:
            newest = (parsed, str(value))
    return newest[1] if newest else None


def _local_time(value: Any) -> str | None:
    """Render an ISO-8601 timestamp as Shanghai wall-clock time for the frontend."""
    parsed = _parse_timestamp(value)
    if parsed is None:
        return None
    return parsed.astimezone(SHANGHAI).strftime("%Y-%m-%d %H:%M:%S")


def _optional_rows(database: str, sql: str) -> list[dict[str, Any]]:
    """Read optional dataset metadata; one missing dataset must not fail the caller."""
    if not DB_PATHS[database].is_file():
        return []
    try:
        return rows(database, sql, [])
    except HTTPException:
        return []


def _mac_sync_report() -> dict[str, Any]:
    """Latest task the remote Mac agent reported to the XDR sync service."""
    latest_job = _optional_rows(
        "sync_control",
        "SELECT id,task,source,state,phase,leased_by,created_at,started_at,completed_at,"
        "updated_at FROM jobs ORDER BY updated_at DESC LIMIT 1",
    )
    dataset_rows = _optional_rows(
        "sync_control",
        "SELECT dataset,revision,last_success_at,row_count,error FROM dataset_state "
        "ORDER BY dataset",
    )
    job = latest_job[0] if latest_job else {}
    return {
        "mac": {
            "agent": job.get("leased_by"),
            "task": job.get("task"),
            "source": job.get("source"),
            "state": job.get("state"),
            "phase": job.get("phase"),
            "reported_at": job.get("updated_at"),
            "reported_at_local": _local_time(job.get("updated_at")),
            "started_at": job.get("started_at"),
            "started_at_local": _local_time(job.get("started_at")),
            "completed_at": job.get("completed_at"),
            "completed_at_local": _local_time(job.get("completed_at")),
        },
        "last_success_at": _latest_timestamp(
            item.get("last_success_at") for item in dataset_rows
        ),
        "datasets": {
            str(item["dataset"]): {
                "last_success_at": item.get("last_success_at"),
                "last_success_at_local": _local_time(item.get("last_success_at")),
                "revision": item.get("revision"),
                "row_count": item.get("row_count"),
                "error": item.get("error"),
            }
            for item in dataset_rows
        },
    }


@app.get("/v1/bi/data-updated-at", tags=["bi"])
def bi_data_updated_at(_: Auth) -> dict[str, Any]:
    """Return when the Mac collector last reported, in UTC and Shanghai time."""
    report = _mac_sync_report()
    reported_at = report["mac"].get("reported_at")
    return {
        "data_updated_at": reported_at,
        "data_updated_at_local": report["mac"].get("reported_at_local"),
        "source": "mac_sync" if reported_at else None,
        "mac": report["mac"],
        "last_success_at": report["last_success_at"],
        "last_success_at_local": _local_time(report["last_success_at"]),
        "datasets": report["datasets"],
    }


def _bi_sales_channels(product_id: str, query_type: str, count_type: str) -> dict[str, Any]:
    if query_type not in ("spu", "sku") or count_type not in ("platform", "channel"):
        raise HTTPException(status_code=422, detail="Invalid product grain or dimension")
    if not paid_orders_available():
        raise HTTPException(status_code=404, detail="Paid-order warehouse is not published")
    if DB_PATHS["paid_orders"].suffix == ".duckdb":
        catalog = one(
            "paid_orders", "SELECT spu_id FROM bi_product_catalog WHERE query_type=? AND product_id=?",
            [query_type, product_id],
        )
        run = one("paid_orders", "SELECT * FROM warehouse_runs ORDER BY published_at DESC LIMIT 1", [])
        fields = ("pay_qty_today", "pay_qty_1d", "pay_qty_3d", "pay_qty_7d",
                  "pay_qty_15d", "pay_qty_30d")
        selected = "platform," + ("shop_id,shop_name," if count_type == "channel" else "") + ",".join(fields)
        found = rows(
            "paid_orders", f"SELECT {selected} FROM bi_sales_channel_rows "
            "WHERE query_type=? AND product_id=? AND count_type=? "
            "ORDER BY coalesce(pay_qty_today,0) DESC,pay_qty_30d DESC,platform,coalesce(shop_id,'')",
            [query_type, product_id, count_type],
        )
        current_today = suppress_stale_today(found, run)
        live_today = attributed_today = attribution_complete = None
        live_metadata: dict[str, Any] = {}
        live_today, attributed_today, attribution_complete, live_metadata = append_unattributed_today(
            found, query_type, product_id, "platform",
        )
        if count_type == "channel" and found and found[-1].get("platform") == "待归因":
            found[-1].update({"shop_id": None, "shop_name": "待订单明细同步"})
        for row in found:
            for field in fields:
                value = row[field]
                if isinstance(value, float) and value.is_integer():
                    row[field] = int(value)
        return {
            "query_type": query_type, "product_id": product_id,
            "sku_id": product_id if query_type == "sku" else None,
            "spu_id": catalog["spu_id"], "count_type": count_type,
            "captured_at": run["captured_at"], "business_date": run["business_date"],
            "start_date": run["start_date"], "end_date": run["end_date"],
            "total": len(found), "rows": found, "source_api": "paid_order_excel_exports",
            "quality": run["quality"], "coverage": "complete_manifest", "complete": True,
            "is_complete_popup": False,
            "today_complete": current_today and run["end_date"] >= run["business_date"],
            "today_date": shanghai_today().isoformat(),
            "stale": not current_today,
            "batch_id": run["batch_id"], "data_version": warehouse_data_version(run),
            "today_source": ("common_order_page_pay_date" if current_today else
                             "inventory_snapshot" if live_today is not None else None),
            "live_pay_qty_today": live_today,
            "attributed_pay_qty_today": attributed_today,
            "attribution_complete": attribution_complete,
            "live_captured_at": live_metadata.get("captured_at"),
        }
    stored = one(
        "paid_orders", "SELECT raw_json FROM ads_sales_channel_snapshots "
        "WHERE query_type=? AND product_id=? AND count_type=?", [query_type, product_id, count_type],
    )
    try:
        result = json.loads(stored["raw_json"])
        if not isinstance(result, dict):
            raise ValueError("snapshot is not an object")
        result["data_version"] = (
            f"{result['batch_id']}:{result['captured_at']}"
            if result.get("batch_id") and result.get("captured_at")
            else result.get("data_version")
        )
        return result
    except (TypeError, ValueError, KeyError) as exc:
        raise HTTPException(status_code=503, detail="Warehouse snapshot is invalid") from exc


@app.get("/v1/bi/sales-channels", tags=["bi"])
def bi_sales_channels(
    _: Auth, product_id: str, query_type: str = "sku", count_type: str = "channel",
) -> dict[str, Any]:
    """Return BI sales windows grouped by platform or shop/channel."""
    return _bi_sales_channels(product_id, query_type, count_type)


