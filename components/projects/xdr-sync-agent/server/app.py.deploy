SHANGHAI = timezone(timedelta(hours=8))


def shanghai_today() -> date:
    """Return the reporting date used by every BI `today` field."""
    return datetime.now(SHANGHAI).date()


def paid_orders_is_today(run: dict[str, Any] | sqlite3.Row) -> bool:
    return str(run["business_date"]) == shanghai_today().isoformat()


def suppress_stale_today(items: list[dict[str, Any]], run: dict[str, Any] | sqlite3.Row) -> bool:
    """Never expose a previous business day's quantity as today's quantity."""
    current = paid_orders_is_today(run)
    if not current:
        for item in items:
            if "pay_qty_today" in item:
                item["pay_qty_today"] = None
    return current


def live_inventory_today_qty(query_type: str, product_id: str) -> tuple[float | None, dict[str, Any]]:
    """Read the freshest same-day JST total used to reconcile partial attribution."""
    table, key = ("sku_inventory", "sku_id") if query_type == "sku" else ("spu_inventory", "spu_id")
    candidates: list[tuple[datetime, float, dict[str, Any]]] = []
    latest_metadata: dict[str, Any] = {}
    for database in dict.fromkeys((inventory_database(), "inventory")):
        metadata = _inventory_snapshot_metadata(database)
        latest_metadata = metadata or latest_metadata
        if metadata.get("snapshot_date") != shanghai_today().isoformat():
            continue
        found = rows(database, f"SELECT pay_qty_today FROM {table} WHERE {key}=?", [product_id])
        if not found or found[0]["pay_qty_today"] is None:
            continue
        captured_at = datetime.fromisoformat(str(metadata["captured_at"]).replace("Z", "+00:00"))
        candidates.append((captured_at, float(found[0]["pay_qty_today"]), metadata))
    if not candidates:
        return None, latest_metadata
    _, quantity, metadata = max(candidates, key=lambda item: item[0])
    return quantity, metadata


def append_unattributed_today(
    items: list[dict[str, Any]], query_type: str, product_id: str, dimension: str,
) -> tuple[float | None, float | None, bool | None, dict[str, Any]]:
    """Make partial channel/platform attribution add up to the live JST total."""
    live_total, metadata = live_inventory_today_qty(query_type, product_id)
    if live_total is None:
        return None, None, None, metadata
    attributed = sum(float(item.get("pay_qty_today") or 0) for item in items)
    gap = live_total - attributed
    complete = abs(gap) < 1e-9
    if gap > 0:
        row = {dimension: "待归因", "pay_qty_today": int(gap) if gap.is_integer() else gap}
        for field in ("pay_qty_1d", "pay_qty_3d", "pay_qty_7d", "pay_qty_15d", "pay_qty_30d"):
            row[field] = 0
        items.append(row)
    return live_total, attributed, complete, metadata

