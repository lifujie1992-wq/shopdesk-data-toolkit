@app.get("/v1/inventory/skus", tags=["inventory"])
def list_skus(
    _: Auth,
    limit: PageLimit = 100,
    offset: PageOffset = 0,
    spu_id: str | None = None,
    sku_id: str | None = None,
    category: str | None = None,
    brand_name: str | None = None,
    stockout_only: bool = False,
) -> dict[str, Any]:
    filters: list[str] = []
    values: list[Any] = []
    add_filter(filters, values, "spu_id", spu_id)
    add_filter(filters, values, "sku_id", sku_id)
    add_filter(filters, values, "category", category)
    add_filter(filters, values, "brand_name", brand_name)
    if stockout_only:
        filters.append("stockout_qty > 0")
    where = f" WHERE {' AND '.join(filters)}" if filters else ""
    values.extend((limit, offset))
    result = rows(
        inventory_database(),
        f"SELECT {','.join(SKU_COLUMNS)} FROM sku_inventory{where} "
        "ORDER BY advice_purchase_qty DESC, spu_id, sku_id LIMIT ? OFFSET ?",
        values,
    )
    return {**page_result(result, limit, offset), **_inventory_snapshot_metadata()}


@app.get("/v1/inventory/spus/{spu_id}", tags=["inventory"])
def get_spu(spu_id: str, _: Auth) -> dict[str, Any]:
    database = inventory_database()
    return {
        **one(
            database,
            f"SELECT {','.join(SPU_COLUMNS)} FROM spu_inventory WHERE spu_id = ?",
            [spu_id],
        ),
        **_inventory_snapshot_metadata(database),
    }


@app.get("/v1/inventory/spus", tags=["inventory"])
def list_spus(
    _: Auth,
