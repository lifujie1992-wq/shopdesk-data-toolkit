def warehouse_page(table: str, filters: list[tuple[str, Any]], limit: int, offset: int) -> dict[str, Any]:
    if not paid_orders_available():
        raise HTTPException(status_code=404, detail="Paid-order warehouse is not published")
    clauses, values = [], []
    for column, value in filters:
        if value is not None:
            clauses.append(f'"{column}"=?')
            values.append(value)
    if not clauses:
        raise HTTPException(status_code=422, detail="At least one filter is required")
    values.extend((limit, offset))
    result = rows("paid_orders", f"SELECT * FROM {table} WHERE {' AND '.join(clauses)} "
                  "ORDER BY pay_qty_today DESC,pay_qty_30d DESC LIMIT ? OFFSET ?", values)
    run = one("paid_orders", "SELECT * FROM warehouse_runs ORDER BY published_at DESC LIMIT 1", [])
    current_today = suppress_stale_today(result, run)
    return {
        **page_result(result, limit, offset),
        "data_version": warehouse_data_version(run),
        "captured_at": run["captured_at"],
        "business_date": run["business_date"],
        "quality": run["quality"],
        "today_date": shanghai_today().isoformat(),
        "today_complete": current_today and run["end_date"] >= run["business_date"],
        "stale": not current_today,
        "today_source": "common_order_page_pay_date" if current_today else None,
    }


