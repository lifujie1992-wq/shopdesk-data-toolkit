def _sku_source_sales(sku_id: str, shop_id: str | None = None, *, bi_contract: bool) -> dict[str, Any]:
    """Build the fixed traffic-source buckets consumed by the BI API."""
    if not paid_orders_available():
        raise HTTPException(status_code=404, detail="Paid-order warehouse is not published")
    table = "ads_sku_shop_source_sales" if shop_id is not None else "ads_sku_source_sales"
    clauses, parameters = ["sku_id=?"], [sku_id]
    if shop_id is not None:
        clauses.append("shop_id=?")
        parameters.append(shop_id)
    found = rows("paid_orders", f"SELECT * FROM {table} WHERE {' AND '.join(clauses)}", parameters)
    run = one("paid_orders", "SELECT * FROM warehouse_runs ORDER BY published_at DESC LIMIT 1", [])
    current_today = suppress_stale_today(found, run)
    indexed = {row["source_category"]: row for row in found}
    buckets = []
    for category in ("精选联盟", "直播间", "商品卡"):
        row = indexed.get(category)
        if row is None:
            values = {field: 0 for field in ("pay_qty_today", "pay_qty_1d", "pay_qty_3d",
                                              "pay_qty_7d", "pay_qty_15d", "pay_qty_30d")}
            if run["end_date"] < run["business_date"]:
                values["pay_qty_today"] = None
            row = {"sku_id": sku_id, "shop_id": shop_id, "source_category": category, **values,
                   "captured_at": run["captured_at"], "quality": run["quality"],
                   "source_labels": None, "influencer_ids": None}
        buckets.append(row)
    live_today = attributed_today = attribution_complete = None
    live_metadata: dict[str, Any] = {}
    if shop_id is None:
        live_today, attributed_today, attribution_complete, live_metadata = append_unattributed_today(
            buckets, "sku", sku_id, "source_category",
        )
        if buckets and buckets[-1].get("source_category") == "待归因":
            buckets[-1].update({"sku_id": sku_id, "shop_id": None,
                                "captured_at": run["captured_at"], "quality": "partial_attribution",
                                "source_labels": None, "influencer_ids": None})
    if bi_contract:
        buckets = [{**row, "source_type": row["source_category"]} for row in buckets]
        for row in buckets:
            del row["source_category"]
    result = {"sku_id": sku_id, "shop_id": shop_id, "captured_at": run["captured_at"],
              "business_date": run["business_date"], "quality": run["quality"], "rows": buckets,
              "today_date": shanghai_today().isoformat(),
              "today_complete": current_today and run["end_date"] >= run["business_date"],
              "stale": not current_today,
              "today_source": ("common_order_page_pay_date" if current_today else
                               "inventory_snapshot" if live_today is not None else None),
              "live_pay_qty_today": live_today,
              "attributed_pay_qty_today": attributed_today,
              "attribution_complete": attribution_complete,
              "live_captured_at": live_metadata.get("captured_at")}
    if bi_contract:
        result.update({"query_type": "sku", "data_version": warehouse_data_version(run)})
    return result


@app.get("/v1/bi/sku-source-sales", tags=["bi"])
def bi_sku_source_sales(_: Auth, sku_id: str, shop_id: str | None = None) -> dict[str, Any]:
    """Return BI-classified 精选联盟/直播间/商品卡 sales for one SKU."""
    return _sku_source_sales(sku_id, shop_id, bi_contract=True)


@app.get("/v1/bi/sku-platform-sales-daily", tags=["bi"])
def bi_sku_platform_sales_daily(
    _: Auth, limit: PageLimit = 100, offset: PageOffset = 0, sku_id: str | None = None,
    spu_id: str | None = None, platform: str | None = None,
    date_from: date | None = None, date_to: date | None = None,
) -> dict[str, Any]:
    """Return daily SKU/platform facts materialized from paid-order exports."""
    if not sku_id and not spu_id:
        raise HTTPException(status_code=422, detail="Provide sku_id or spu_id")
    if date_from and date_to and date_from > date_to:
        raise HTTPException(status_code=422, detail="date_from must not exceed date_to")
    clauses, parameters = [], []
    for column, value in (("sku_id", sku_id), ("spu_id", spu_id), ("platform", platform)):
        add_filter(clauses, parameters, column, value)
    if date_from is not None:
        clauses.append('"biz_date" >= ?')
        parameters.append(date_from.isoformat())
    if date_to is not None:
        clauses.append('"biz_date" <= ?')
        parameters.append(date_to.isoformat())
    parameters.extend((limit, offset))
    items = rows(
        "paid_orders",
        f"SELECT * FROM bi_sku_platform_sales_daily WHERE {' AND '.join(clauses)} "
        "ORDER BY biz_date DESC,platform LIMIT ? OFFSET ?",
        parameters,
    )
    run = one("paid_orders", "SELECT * FROM warehouse_runs ORDER BY published_at DESC LIMIT 1", [])
    return {
        **page_result(items, limit, offset),
        "data_version": warehouse_data_version(run),
        "captured_at": run["captured_at"],
        "business_date": run["business_date"],
        "quality": run["quality"],
    }


@app.get("/v1/warehouse/sku-source-sales", tags=["warehouse"], deprecated=True,
         include_in_schema=False)
