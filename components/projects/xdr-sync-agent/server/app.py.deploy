        [spu_id, biz_date.isoformat()],
    )


@app.get("/v1/inventory/product-daily-sales", tags=["inventory"])
def list_product_daily_sales(
    _: Auth,
    spu_id: str,
    limit: PageLimit = 100,
    offset: PageOffset = 0,
    date_from: date | None = None,
    date_to: date | None = None,
) -> dict[str, Any]:
    if date_from and date_to and date_from > date_to:
        raise HTTPException(status_code=422, detail="date_from must not be later than date_to")
    filters = ['"spu_id" = ?']
    values: list[Any] = [spu_id]
    if date_from:
        filters.append("biz_date >= ?")
        values.append(date_from.isoformat())
    if date_to:
        filters.append("biz_date <= ?")
        values.append(date_to.isoformat())
    values.extend((limit, offset))
    result = rows(
        "inventory",
        f"SELECT {','.join(PRODUCT_DAILY_SALES_COLUMNS)} "
        f"FROM product_daily_sales_analysis WHERE {' AND '.join(filters)} "
        "ORDER BY biz_date DESC LIMIT ? OFFSET ?",
        values,
    )
    return page_result(result, limit, offset)


