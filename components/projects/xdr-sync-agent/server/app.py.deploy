@app.get("/v1/inventory/sales-channels", tags=["inventory"])
def get_sale_channel_snapshot(
    _: Auth, product_id: str, query_type: str = "sku", count_type: str = "channel",
) -> dict[str, Any]:
    if query_type not in ("spu", "sku") or count_type not in ("platform", "channel"):
        raise HTTPException(status_code=422, detail="Invalid product grain or dimension")
    # A batch list is a different, lower-coverage source. Never merge its rows
    # into a popup snapshot or replace a complete popup merely because it is old.
    snapshot_tables = ("sale_channel_snapshots", "sale_channel_batch_snapshots")
    stored = None
    is_batch = False
    try:
        with closing(connect("inventory")) as connection:
            available = {row["name"] for row in connection.execute(
                "SELECT name FROM sqlite_master WHERE type='table' AND name IN (?,?)",
                snapshot_tables,
            )}
            if not available:
                raise HTTPException(status_code=503, detail="Sales channel snapshots are not available")
            for table in snapshot_tables:
                if table not in available:
                    continue
                stored = connection.execute(
                    f"SELECT raw_json FROM {table} "
                    "WHERE query_type=? AND product_id=? AND count_type=?",
                    [query_type, product_id, count_type],
                ).fetchone()
                if stored is not None:
                    is_batch = table == "sale_channel_batch_snapshots"
                    break
    except sqlite3.Error as exc:
        raise HTTPException(status_code=503, detail="Database is temporarily unavailable") from exc
    if stored is None:
        raise HTTPException(status_code=404, detail="Record not found")
    try:
        result = json.loads(stored["raw_json"])
        if (not isinstance(result, dict)
                or result.get("query_type") != query_type
                or result.get("count_type") != count_type
                or result.get("product_id", result.get(f"{query_type}_id")) != product_id
                or not isinstance(result.get("rows"), list)
                or type(result.get("total")) is not int
                or result["total"] < 0
                or len(result["rows"]) != result["total"]):
            raise ValueError("Invalid snapshot identity, rows or total")
        captured = datetime.fromisoformat(result["captured_at"].replace("Z", "+00:00"))
        if captured.tzinfo is None:
            raise ValueError("Snapshot timestamp has no timezone")
    except (ValueError, TypeError, KeyError, AttributeError) as exc:
        raise HTTPException(status_code=503, detail="Sales channel snapshot is invalid") from exc
    if is_batch:
        if not result["rows"]:
            raise HTTPException(status_code=404, detail="Record not found")
        result.update({
            "source_api": "purchase_alarm_sku_detail_unfold",
            "quality": "batch_list",
            "coverage": "listed_shops_only",
            "scope": "listed_shops_only",
            "complete": False,
            "is_complete_popup": False,
            "distributor_granularity": "unavailable",
        })
    else:
        # Older complete snapshots predate these metadata fields.
        result.setdefault("source_api", "purchase_alarm_sale_channel_detail")
        result.setdefault("quality", "complete_popup")
        result.setdefault("coverage", "all_returned_records")
        result.setdefault("complete", True)
        result.setdefault("is_complete_popup", True)
    result["stale"] = (datetime.now(timezone.utc) - captured).total_seconds() > 900
    result["snapshot_version"] = result.get("completed_at", result["captured_at"])
    result.setdefault("data_version", result["snapshot_version"])
    return result


@app.get("/v1/bi/shop-directory", tags=["bi"])
@app.get("/v1/inventory/shop-directory", tags=["inventory"])
def list_inventory_shop_directory(
    _: Auth, limit: PageLimit = 100, offset: PageOffset = 0,
    platform: Annotated[list[str] | None, Query()] = None,
    shop_name: str | None = None,
) -> dict[str, Any]:
    """Return the platform/shop tree captured from JST's platform_shop_list."""
    platforms = list(dict.fromkeys(value for value in (platform or []) if value))
    if len(platforms) > 100:
        raise HTTPException(status_code=422, detail="Too many platform filters")
    try:
        with closing(connect("inventory")) as connection:
            exact = connection.execute(
                "SELECT 1 FROM sqlite_master WHERE type='table' AND name='shop_directory'"
            ).fetchone()
            if exact:
                filters, values = [], []
                if platforms:
                    filters.append(f"platform IN ({','.join('?' for _ in platforms)})")
                    values.extend(platforms)
                if shop_name:
                    filters.append("shop_name LIKE ? ESCAPE '\\'")
                    values.append(like_contains(shop_name))
                where = f" WHERE {' AND '.join(filters)}" if filters else ""
                total = connection.execute(
                    f"SELECT count(*) FROM shop_directory{where}", values,
                ).fetchone()[0]
                result = [dict(row) for row in connection.execute(
                    "SELECT shop_id,shop_name,platform,captured_at FROM shop_directory"
                    f"{where} ORDER BY platform,shop_name,shop_id LIMIT ? OFFSET ?",
                    [*values, limit, offset],
                ).fetchall()]
                source = "platform_shop_list"
            else:
                filters, values = ["shop_id<>''", "coalesce(shop_name,'')<>''", "coalesce(platform,'')<>''"], []
                if platforms:
                    filters.append(f"platform IN ({','.join('?' for _ in platforms)})")
                    values.extend(platforms)
                if shop_name:
                    filters.append("shop_name LIKE ? ESCAPE '\\'")
                    values.append(like_contains(shop_name))
                where = f" WHERE {' AND '.join(filters)}"
                total = connection.execute(
                    "SELECT count(*) FROM (SELECT shop_id FROM shop_product_sales_analysis"
                    f"{where} GROUP BY shop_id)", values,
                ).fetchone()[0]
                result = [dict(row) for row in connection.execute(
                    "SELECT shop_id,max(shop_name) AS shop_name,max(platform) AS platform,"
                    "NULL AS captured_at FROM shop_product_sales_analysis "
                    f"{where} GROUP BY shop_id "
                    "ORDER BY platform,shop_name,shop_id LIMIT ? OFFSET ?",
                    [*values, limit, offset],
                ).fetchall()]
                source = "shop_product_sales_analysis_fallback"
    except sqlite3.Error as exc:
        raise HTTPException(status_code=503, detail="Database is temporarily unavailable") from exc
    return {**page_result(result, limit, offset), "total": total, "source": source}


@app.get("/v1/bi/shop-groups", tags=["bi"])
@app.get("/v1/inventory/shop-groups", tags=["inventory"])
def list_inventory_shop_groups(
    _: Auth, limit: PageLimit = 100, offset: PageOffset = 0,
) -> dict[str, Any]:
    """Return JST's explicit shop-group membership; never infer it from names."""
    try:
        with closing(connect("inventory")) as connection:
            tables = {row["name"] for row in connection.execute(
                "SELECT name FROM sqlite_master WHERE type='table' "
                "AND name IN ('shop_groups','shop_group_members')"
            )}
            if tables != {"shop_groups", "shop_group_members"}:
                raise HTTPException(status_code=404, detail="Shop groups are not published")
            total = connection.execute("SELECT count(*) FROM shop_groups").fetchone()[0]
            groups = [dict(row) for row in connection.execute(
                "SELECT group_id,group_name,shop_count,captured_at FROM shop_groups "
                "ORDER BY group_name,group_id LIMIT ? OFFSET ?", [limit, offset],
            ).fetchall()]
            for group in groups:
                group["shop_ids"] = [row["shop_id"] for row in connection.execute(
                    "SELECT shop_id FROM shop_group_members WHERE group_id=? ORDER BY shop_id",
                    [group["group_id"]],
                ).fetchall()]
                if len(group["shop_ids"]) != group["shop_count"]:
                    raise HTTPException(status_code=503, detail="Shop group membership is incomplete")
    except HTTPException:
        raise
    except sqlite3.Error as exc:
        raise HTTPException(status_code=503, detail="Database is temporarily unavailable") from exc
    return {**page_result(groups, limit, offset), "total": total,
            "source": "query_shop_group_config"}


@app.get("/v1/bi/inventory-products", tags=["bi"])
def bi_inventory_products(
    _: Auth,
    limit: PageLimit = 100,
    offset: PageOffset = 0,
    view_type: str = "sku",
    platform: Annotated[list[str] | None, Query()] = None,
    shop_id: Annotated[list[str] | None, Query()] = None,
    shop_group_id: Annotated[list[str] | None, Query()] = None,
    stockout_only: bool = False,
) -> dict[str, Any]:
    """Filter inventory by platform, JST shop group and/or shop order relations."""
    if view_type not in ("spu", "sku"):
        raise HTTPException(status_code=422, detail="view_type must be spu or sku")
    platforms = list(dict.fromkeys(value for value in (platform or []) if value))
    shop_ids = list(dict.fromkeys(value for value in (shop_id or []) if value))
    shop_group_ids = list(dict.fromkeys(value for value in (shop_group_id or []) if value))
    if not platforms and not shop_ids and not shop_group_ids:
        raise HTTPException(status_code=422, detail="Provide platform, shop_group_id or shop_id")
    if len(platforms) + len(shop_ids) + len(shop_group_ids) > 200:
        raise HTTPException(status_code=422, detail="Too many platform/shop-group/shop filters")
    if not paid_orders_available():
        raise HTTPException(status_code=404, detail="Paid-order warehouse is not published")

    order_filters: list[str] = []
    order_values: list[Any] = []
    if platforms:
        order_filters.append(f"o.platform IN ({','.join('?' for _ in platforms)})")
        order_values.extend(platforms)
    if shop_ids:
        order_filters.append(f"o.shop_id IN ({','.join('?' for _ in shop_ids)})")
        order_values.extend(shop_ids)
    if shop_group_ids:
        order_filters.append("o.shop_id IN (SELECT shop_id FROM shop_group_members "
                             f"WHERE group_id IN ({','.join('?' for _ in shop_group_ids)}))")
        order_values.extend(shop_group_ids)
    order_where = " AND ".join(order_filters)

    try:
        with closing(connect("inventory")) as connection:
            if shop_group_ids:
                found_groups = connection.execute(
                    f"SELECT count(*) FROM shop_groups WHERE group_id IN ({','.join('?' for _ in shop_group_ids)})",
                    shop_group_ids,
                ).fetchone()[0]
                if found_groups != len(shop_group_ids):
                    raise HTTPException(status_code=422, detail="Unknown shop_group_id")
            paid_source = PAID_ORDERS_ODS_PATH if PAID_ORDERS_ODS_PATH.is_file() else DB_PATHS["paid_orders"]
            paid_uri = f"file:{quote(str(paid_source))}?mode=ro"
            connection.execute("ATTACH DATABASE ? AS paid", [paid_uri])
            run = connection.execute(
                "SELECT batch_id,business_date,start_date,end_date,captured_at,published_at,quality "
                "FROM paid.warehouse_runs ORDER BY published_at DESC LIMIT 1"
            ).fetchone()
            if run is None:
                raise HTTPException(status_code=404, detail="Paid-order warehouse is empty")
            inventory_run = connection.execute(
                "SELECT completed_at FROM export_info ORDER BY id DESC LIMIT 1"
            ).fetchone()

            if view_type == "sku":
                columns = SKU_COLUMNS
                source_table = "sku_inventory i"
                relation = (
                    "i.sku_id IN (SELECT o.sku_id FROM paid.paid_order_items_raw o "
                    f"WHERE {order_where})"
                )
            else:
                columns = SPU_COLUMNS
                source_table = "spu_inventory i"
                relation = (
                    "i.spu_id IN (SELECT k.spu_id FROM sku_inventory k "
                    "WHERE k.sku_id IN (SELECT o.sku_id FROM paid.paid_order_items_raw o "
                    f"WHERE {order_where}))"
                )
            inventory_filters = [relation]
            if stockout_only:
                inventory_filters.append("i.stockout_qty > 0")
            where = " AND ".join(inventory_filters)
            total = connection.execute(
                f"SELECT count(*) FROM {source_table} WHERE {where}", order_values,
            ).fetchone()[0]
            selected = ",".join(f'i."{column}"' for column in columns)
            items = [dict(row) for row in connection.execute(
                f"SELECT {selected} FROM {source_table} WHERE {where} "
                "ORDER BY i.advice_purchase_qty DESC,i.spu_id"
                + (",i.sku_id" if view_type == "sku" else "")
                + " LIMIT ? OFFSET ?",
                [*order_values, limit, offset],
            ).fetchall()]
    except HTTPException:
        raise
    except sqlite3.Error as exc:
        raise HTTPException(status_code=503, detail="Database is temporarily unavailable") from exc

    return {
        **page_result(items, limit, offset),
        "total": total,
        "view_type": view_type,
        "filters": {"platform": platforms, "shop_group_id": shop_group_ids, "shop_id": shop_ids,
                    "stockout_only": stockout_only},
        "source": "paid_order_excel_exports",
        "quality": "order_derived_scope",
        "relationship_start_date": run["start_date"],
        "relationship_end_date": run["end_date"],
        "captured_at": run["captured_at"],
        "data_version": warehouse_data_version(run),
        "inventory_captured_at": inventory_run["completed_at"] if inventory_run else None,
    }


@app.get("/v1/bi/inventory-product-scope", tags=["bi"])
def bi_inventory_product_scope(
    _: Auth,
    platform: Annotated[list[str] | None, Query()] = None,
    shop_id: Annotated[list[str] | None, Query()] = None,
    shop_group_id: Annotated[list[str] | None, Query()] = None,
) -> dict[str, Any]:
    """Return SKU/SPU identities for a platform, JST group and/or shop filter."""
    platforms = list(dict.fromkeys(value for value in (platform or []) if value))
    shop_ids = list(dict.fromkeys(value for value in (shop_id or []) if value))
    shop_group_ids = list(dict.fromkeys(value for value in (shop_group_id or []) if value))
    if not platforms and not shop_ids and not shop_group_ids:
        raise HTTPException(status_code=422, detail="Provide platform, shop_group_id or shop_id")
    if len(platforms) + len(shop_ids) + len(shop_group_ids) > 200:
        raise HTTPException(status_code=422, detail="Too many platform/shop-group/shop filters")
    if not paid_orders_available():
        raise HTTPException(status_code=404, detail="Paid-order warehouse is not published")

    order_filters: list[str] = []
    order_values: list[Any] = []
    if platforms:
        order_filters.append(f"o.platform IN ({','.join('?' for _ in platforms)})")
        order_values.extend(platforms)
    if shop_ids:
        order_filters.append(f"o.shop_id IN ({','.join('?' for _ in shop_ids)})")
        order_values.extend(shop_ids)
    if shop_group_ids:
        order_filters.append("o.shop_id IN (SELECT shop_id FROM shop_group_members "
                             f"WHERE group_id IN ({','.join('?' for _ in shop_group_ids)}))")
        order_values.extend(shop_group_ids)
    order_where = " AND ".join(order_filters)

    try:
        with closing(connect("inventory")) as connection:
            if shop_group_ids:
                found_groups = connection.execute(
                    f"SELECT count(*) FROM shop_groups WHERE group_id IN ({','.join('?' for _ in shop_group_ids)})",
                    shop_group_ids,
                ).fetchone()[0]
                if found_groups != len(shop_group_ids):
                    raise HTTPException(status_code=422, detail="Unknown shop_group_id")
            paid_source = PAID_ORDERS_ODS_PATH if PAID_ORDERS_ODS_PATH.is_file() else DB_PATHS["paid_orders"]
            paid_uri = f"file:{quote(str(paid_source))}?mode=ro"
            connection.execute("ATTACH DATABASE ? AS paid", [paid_uri])
            run = connection.execute(
                "SELECT batch_id,business_date,start_date,end_date,captured_at,published_at,quality "
                "FROM paid.warehouse_runs ORDER BY published_at DESC LIMIT 1"
            ).fetchone()
            if run is None:
                raise HTTPException(status_code=404, detail="Paid-order warehouse is empty")
            inventory_run = connection.execute(
                "SELECT completed_at FROM export_info ORDER BY id DESC LIMIT 1"
            ).fetchone()
            items = [dict(row) for row in connection.execute(
                "SELECT i.spu_id,i.sku_id FROM sku_inventory i "
                "WHERE i.sku_id IN (SELECT o.sku_id FROM paid.paid_order_items_raw o "
                f"WHERE {order_where}) ORDER BY i.spu_id,i.sku_id",
                order_values,
            ).fetchall()]
    except HTTPException:
        raise
    except sqlite3.Error as exc:
        raise HTTPException(status_code=503, detail="Database is temporarily unavailable") from exc

    return {
        "items": items,
        "total": len(items),
        "spu_total": len({item["spu_id"] for item in items}),
        "filters": {"platform": platforms, "shop_group_id": shop_group_ids, "shop_id": shop_ids},
        "source": "paid_order_excel_exports",
        "quality": "order_derived_scope",
        "relationship_start_date": run["start_date"],
        "relationship_end_date": run["end_date"],
        "captured_at": run["captured_at"],
        "data_version": warehouse_data_version(run),
        "inventory_captured_at": inventory_run["completed_at"] if inventory_run else None,
    }


@app.get("/v1/bi/product-scope", tags=["bi"])
@app.get("/v1/inventory/product-scope", tags=["inventory"])
def list_inventory_product_scope(
    _: Auth,
    limit: PageLimit = 100,
    offset: PageOffset = 0,
    platform: Annotated[list[str] | None, Query()] = None,
    shop_id: Annotated[list[str] | None, Query()] = None,
) -> dict[str, Any]:
    """Return SPUs related to any selected platform or shop in sales analysis."""
    platforms = list(dict.fromkeys(value for value in (platform or []) if value))
    shop_ids = list(dict.fromkeys(value for value in (shop_id or []) if value))
    if not platforms and not shop_ids:
        raise HTTPException(status_code=422, detail="Provide platform or shop_id")
    if len(platforms) + len(shop_ids) > 200:
        raise HTTPException(status_code=422, detail="Too many platform/shop filters")
    selects: list[str] = []
    values: list[Any] = []
    if platforms:
        selects.append(
            "SELECT spu_id FROM platform_product_sales_analysis "
            f"WHERE platform IN ({','.join('?' for _ in platforms)})"
        )
        values.extend(platforms)
    if shop_ids:
        selects.append(
            "SELECT spu_id FROM shop_product_sales_analysis "
            f"WHERE shop_id IN ({','.join('?' for _ in shop_ids)})"
        )
        values.extend(shop_ids)
    values.extend((limit, offset))
    result = rows(
        "inventory",
        f"SELECT spu_id FROM ({' UNION '.join(selects)}) "
        "WHERE spu_id<>'' ORDER BY spu_id LIMIT ? OFFSET ?",
        values,
    )
    return page_result(result, limit, offset)


@app.get("/v1/inventory/shop-sales", tags=["inventory"])
def list_shop_product_sales(
    _: Auth,
    limit: PageLimit = 100,
    offset: PageOffset = 0,
    spu_id: str | None = None,
    shop_id: str | None = None,
    shop_name: str | None = None,
    platform: str | None = None,
) -> dict[str, Any]:
    if not any((spu_id, shop_id)):
        raise HTTPException(status_code=422, detail="Provide spu_id or shop_id")
