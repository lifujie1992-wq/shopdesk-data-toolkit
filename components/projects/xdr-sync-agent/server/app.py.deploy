@app.get("/v1/orders", tags=["orders"])
def list_orders(
    _: Auth,
    limit: PageLimit = 100,
    offset: PageOffset = 0,
    so_id: str | None = None,
    outer_so_id: str | None = None,
    sku_id: str | None = None,
    shop_name: str | None = None,
    platform: str | None = None,
    order_status: Annotated[str | None, Query(alias="status")] = None,
    send_from: datetime | None = None,
    send_to: datetime | None = None,
) -> dict[str, Any]:
    if not any((so_id, outer_so_id, shop_name, send_from, send_to)):
        raise HTTPException(
            status_code=422,
            detail="Provide at least one indexed constraint: so_id, outer_so_id, shop_name, send_from, or send_to",
        )
    if send_from and send_to and send_from > send_to:
        raise HTTPException(status_code=422, detail="send_from must not be later than send_to")

    filters: list[str] = []
    values: list[Any] = []
    for column, value in (
        ("so_id", so_id), ("outer_so_id", outer_so_id), ("sku_id", sku_id),
        ("shop_name", shop_name), ("platform", platform), ("status", order_status),
    ):
        add_filter(filters, values, column, value)
    if send_from:
        filters.append("send_date >= ?")
        values.append(send_from.isoformat(sep=" "))
    if send_to:
        filters.append("send_date <= ?")
        values.append(send_to.isoformat(sep=" "))
    values.extend((limit, offset))
    result = rows(
        "orders",
        f"SELECT {','.join(ORDER_COLUMNS)} FROM order_details WHERE {' AND '.join(filters)} "
        "ORDER BY send_date DESC, o_id DESC LIMIT ? OFFSET ?",
        values,
    )
    return page_result(result, limit, offset)


@app.get("/v1/order-items", tags=["orders"])
def list_order_items(
    _: Auth,
    limit: PageLimit = 100,
    offset: PageOffset = 0,
    o_id: str | None = None,
    so_id: str | None = None,
    sku_id: str | None = None,
    shop_id: str | None = None,
    send_from: datetime | None = None,
    send_to: datetime | None = None,
) -> dict[str, Any]:
    if not any((o_id, so_id, sku_id, shop_id, send_from, send_to)):
        raise HTTPException(status_code=422, detail="Provide o_id, so_id, sku_id, shop_id, or a send-date range")
    if send_from and send_to and send_from > send_to:
        raise HTTPException(status_code=422, detail="send_from must not be later than send_to")
    filters: list[str] = []
    values: list[Any] = []
    for column, value in (("o_id", o_id), ("so_id", so_id), ("sku_id", sku_id), ("shop_id", shop_id)):
        add_filter(filters, values, column, value)
    if send_from:
        filters.append("send_date >= ?")
        values.append(send_from.isoformat(sep=" "))
    if send_to:
        filters.append("send_date <= ?")
        values.append(send_to.isoformat(sep=" "))
    values.extend((limit, offset))
    result = rows(
        "orders",
        f"SELECT {','.join(ORDER_ITEM_COLUMNS)} FROM order_item_details WHERE {' AND '.join(filters)} "
        "ORDER BY send_date DESC, o_id DESC, sku_row_number, sku_id LIMIT ? OFFSET ?",
        values,
    )
    return page_result(result, limit, offset)


