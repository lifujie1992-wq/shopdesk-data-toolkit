    brand_name: str | None = None,
    stockout_only: bool = False,
) -> dict[str, Any]:
    filters: list[str] = []
    values: list[Any] = []
    add_filter(filters, values, "category", category)
    add_filter(filters, values, "brand_name", brand_name)
    if stockout_only:
        filters.append("stockout_qty > 0")
    where = f" WHERE {' AND '.join(filters)}" if filters else ""
    values.extend((limit, offset))
    result = rows(
        spu_database(),
        f"SELECT {','.join(SPU_COLUMNS)} FROM spu_inventory{where} "
        "ORDER BY advice_purchase_qty DESC, spu_id LIMIT ? OFFSET ?",
