{
  "name": "shopdesk-agents",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "shopdesk-agents",
      "version": "0.1.0",
      "workspaces": [
        "packages/core",
        "sources/jst"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@shopdesk/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@shopdesk/jst": {
      "resolved": "sources/jst",
      "link": true
    },
    "packages/core": {
      "name": "@shopdesk/core",
      "version": "0.1.0"
    },
    "sources/jst": {
      "name": "@shopdesk/jst",
      "version": "0.1.0",
      "dependencies": {
        "@shopdesk/core": "0.1.0"
      },
      "bin": {
        "jst": "bin/jst.js"
      }
    }
  }
}
