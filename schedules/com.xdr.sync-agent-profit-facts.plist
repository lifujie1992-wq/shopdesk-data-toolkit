<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.xdr.sync-agent-profit-facts</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>__NODE__</string>
		<string>__HOME__/xdr-sync-agent/bin/xdr-sync-agent.js</string>
		<string>daemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/xdr-sync-agent-profit-facts/launchd.err.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/xdr-sync-agent-profit-facts/launchd.out.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
</dict>
</plist>
