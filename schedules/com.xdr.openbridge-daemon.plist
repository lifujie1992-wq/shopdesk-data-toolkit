<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.xdr.openbridge-daemon</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>__NODE__</string>
		<string>__HOME__/.openbridge/repo/packages/daemon/dist/cli/index.js</string>
		<string>serve</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/.openbridge/repo/.openbridge-data/daemon.err.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.openbridge/repo/.openbridge-data/daemon.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>__HOME__/.openbridge/repo</string>
</dict>
</plist>
