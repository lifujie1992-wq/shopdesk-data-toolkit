<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.shopdesk.aftersale-push</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>__HOME__/projects/shopdesk-aftersale/bin/push.py</string>
		<string>--once</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/projects/shopdesk-aftersale/logs/launchd-push.err.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/projects/shopdesk-aftersale/logs/launchd-push.out.log</string>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>ThrottleInterval</key>
	<integer>60</integer>
	<key>WorkingDirectory</key>
	<string>__HOME__/projects/shopdesk-aftersale</string>
</dict>
</plist>
