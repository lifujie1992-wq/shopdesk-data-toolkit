<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.invoice-capture-cleanup</string>
	<key>Nice</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>__NODE__</string>
		<string>__HOME__/projects/invoice-mac-agent/capture-cleanup-cli.mjs</string>
		<string>--once</string>
	</array>
	<key>StandardErrorPath</key>
	<string>__HOME__/.local/share/invoice-mac-agent/logs/capture-cleanup.err.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.local/share/invoice-mac-agent/logs/capture-cleanup.out.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>10</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>__HOME__/projects/invoice-mac-agent</string>
</dict>
</plist>
