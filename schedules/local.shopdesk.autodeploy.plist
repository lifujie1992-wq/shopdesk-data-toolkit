<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.shopdesk.autodeploy</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__HOME__/shopdesk-workbench-src/autodeploy.sh</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/tmp/shopdesk-autodeploy.err.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/shopdesk-autodeploy.out.log</string>
	<key>StartInterval</key>
	<integer>300</integer>
</dict>
</plist>
