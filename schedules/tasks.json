      "cwd": "~/projects/shopdesk-aftersale",
      "env": {
        "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
        "LANG": "zh_CN.UTF-8"
      },
      "calendar": [
        {
          "minute": 2
        },
        {
          "minute": 32
        }
      ],
      "throttleInterval": 60,
      "log": "~/projects/shopdesk-aftersale/logs/launchd.out.log",
      "errorLog": "~/projects/shopdesk-aftersale/logs/launchd.err.log",
      "enabled": true
