{
  "sources": {
    "shopdesk": {
      "name": "店铺取数任务"
    }
  },
  "agents": {
    "fixer": {
      "name": "自修 Agent",
      "worker": "this-machine",
      "use": "command",
      "command": [
        "pi",
        "--print",
        "{prompt}"
      ],
      "access": "edit",
      "timeout": 20
    },
    "advisor": {
      "name": "只读排查 Agent",
      "worker": "this-machine",
      "use": "command",
      "command": [
        "pi",
        "--print",
        "{prompt}"
      ],
      "access": "read",
      "timeout": 20
    }
  },
  "rules": [
    {
      "name": "自修：xdr",
      "when": {
        "source": "shopdesk",
        "types": [
          "task.failed.xdr"
        ]
      },
      "to": "fixer",
      "cwd": "/Users/zhaoxiaozhong/projects/xdr-sync-agent",
      "skill": "shopdesk-ops",
      "parallel": 2
    },
    {
      "name": "自修：monthly",
